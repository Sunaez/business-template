# No environment variables are needed for the local demo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional visual preset: studio, gallery, or after-dark.
STOREFRONT_PRESET=studio
# Enable only for a launched store with real products and working checkout.
# The preview feed works without these flags: /feeds/google.xml?preview=1
SITE_INDEXING_ENABLED=false
GOOGLE_MERCHANT_ENABLED=false
# Future server-only integrations belong behind lib/catalog.ts and lib/checkout.ts.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
